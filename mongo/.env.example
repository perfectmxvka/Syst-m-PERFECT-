# Supabase Dashboard -> Connect -> Session pooler (PostgreSQL URI).
# Replace placeholders locally or enter the URL securely in Render environment settings.
SUPABASE_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# Render supplies RENDER_EXTERNAL_URL automatically. Override for a custom domain:
# PUBLIC_ORIGIN=https://YOUR-APP.example.com
# Supabase CA is bundled automatically. For other PostgreSQL hosts only:
# SUPABASE_CA_CERT_PATH=/path/to/prod-supabase.cer
# Optional integrations: Cloudinary for NEW photo uploads, VAPID for push,
# RESEND_API_KEY and MAIL_FROM for mail. Existing imported data needs none of these.
# PUSH_ENABLED=false
# PG_LOCAL_TEST is for isolated localhost test databases only. Never set in production.
