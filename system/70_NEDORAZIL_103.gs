/** Nedostavení: odvozené upozornění, evidence vyúčtování a trvalá e-mailová fronta. */
function perfect103NoShowRows_(){var sh=perfectDatabaseGetSpreadsheet_().getSheetByName('__PERFECT103_NOSHOW');return !sh||sh.getLastRow()<2?[]:sh.getRange(2,1,sh.getLastRow()-1,2).getValues().map(function(r){var v=JSON.parse(r[1]);if(v.key!==r[0])throw Error('Poškozená evidence nedostavení.');return v;});}
function perfect103NoShowPut_(value){var ss=perfectDatabaseGetSpreadsheet_(),sh=ss.getSheetByName('__PERFECT103_NOSHOW');if(!sh){sh=ss.insertSheet('__PERFECT103_NOSHOW');sh.appendRow(['KEY','JSON']);sh.hideSheet();}var rows=perfect103NoShowRows_(),i=rows.findIndex(function(r){return r.key===value.key;});sh.getRange(i<0?sh.getLastRow()+1:i+2,1,1,2).setValues([[value.key,JSON.stringify(value)]]);}
function perfect103NoShowList_(customerId,orders,records){return orders.filter(function(o){return String(o.CUSTOMER_ID)===String(customerId)&&String(o.STAV_OBJEDNAVKY).trim().toUpperCase()==='NEDORAZIL';}).map(function(o){var price=o.CENA_CELKEM===''||o.CENA_CELKEM==null?null:Math.round(databaseMoney_(o.CENA_CELKEM)*100),settled=records.find(function(r){return r.key==='settled:'+o.ORDER_ID;});return {orderId:String(o.ORDER_ID),date:perfectRepairSerializable_(o.DATUM_OBJEDNANI,'DATUM_OBJEDNANI'),time:String(o.CAS_PRIJEZDU||''),vehicle:String(o.VOZIDLO||''),plate:perfect103PlateDisplay_(o.SPZ),program:String(o.MYCI_PROGRAM||''),priceCents:price,feeCents:price===null?null:Math.round(price/2),settled:!!settled,settledAt:settled&&settled.at,chargedOrderId:settled&&settled.chargedOrderId};});}
function perfect103NoShowFlag_(flag,orders,records){var list=perfect103NoShowList_(flag.customerId,orders||databaseGetAllOrders(),records||perfect103NoShowRows_());if(!list.length)return flag;var notes=list.map(function(n){return 'NEDORAZIL · '+n.orderId+' · '+n.date+' '+n.time+' · '+n.vehicle+' '+n.plate+' · '+(n.settled?'Pokuta již vyúčtována v '+n.chargedOrderId:n.feeCents===null?'Chybí původní cena — ověřit pokutu.':'Při příští návštěvě doúčtovat 50 %: '+(n.feeCents/100).toFixed(2)+' Kč');});return Object.assign({},flag,{active:true,manualActive:flag.active,manualNote:flag.note,noShows103:list,note:[flag.active?flag.note:''].concat(notes).filter(Boolean).join('\n')});}
function perfect103NoShowBootstrap_(data,ids){var orders=databaseGetAllOrders(),records=perfect103NoShowRows_();ids.forEach(function(id){var flag=data.customerFlags102[id]||{customerId:id,active:false,note:'',version:0};var value=perfect103NoShowFlag_(flag,orders,records);if(value.active||data.customerFlags102[id])data.customerFlags102[id]=value;});return data;}
function perfect103NoShowSettle(token,input){return perfect101Context_(token,'prices.edit',function(actor){perfect102RequireAdmin_(actor);return perfectDatabaseWithLock_('Vyúčtování nedostavení',function(){var fresh=perfect40Require_(token,'prices.edit');perfect102RequireAdmin_(fresh);var p=input||{},old=databaseFindOrderById(String(p.orderId||'')),charged=databaseFindOrderById(String(p.chargedOrderId||''));if(!old||old.STAV_OBJEDNAVKY!=='NEDORAZIL'||!charged||old.ORDER_ID===charged.ORDER_ID||String(old.CUSTOMER_ID)!==String(charged.CUSTOMER_ID)||['ZRUŠENO','NEDORAZIL'].indexOf(charged.STAV_OBJEDNAVKY)>=0)throw Error('Vyber existující navazující zakázku stejného zákazníka.');if(String(perfectRepairSerializable_(charged.DATUM_OBJEDNANI))<String(perfectRepairSerializable_(old.DATUM_OBJEDNANI)))throw Error('Vyúčtování nemůže předcházet nedostavení.');var records=perfect103NoShowRows_(),key='settled:'+old.ORDER_ID,existing=records.find(function(r){return r.key===key;});if(existing){if(existing.chargedOrderId!==charged.ORDER_ID)throw Error('Pokuta již byla vyúčtována jinde.');}else{var fee=perfect103NoShowList_(old.CUSTOMER_ID,[old],[])[0].feeCents;if(fee===null)throw Error('Chybí původní cena.');perfect103NoShowPut_({key:key,kind:'settlement',orderId:old.ORDER_ID,chargedOrderId:charged.ORDER_ID,feeCents:fee,actorId:String(fresh.id),at:new Date().toISOString()});}CacheService.getScriptCache().remove('PERFECT101_FINGERPRINT');return perfect102CustomerFlagGet(token,old.CUSTOMER_ID);});});}
function perfect103NoShowScan_(){return perfectDatabaseWithLock_('Fronta nedostavení',function(){var orders=databaseGetAllOrders(),records=perfect103NoShowRows_(),now=new Date(),today=Utilities.formatDate(now,'Europe/Prague','yyyy-MM-dd'),at=Utilities.formatDate(now,'Europe/Prague','yyyy-MM-dd HH:mm');function stamp(o){return perfectRepairSerializable_(o.DATUM_OBJEDNANI)+' '+String(o.CAS_PRIJEZDU||'00:00');}orders.filter(function(o){return o.CUSTOMER_ID&&o.STAV_OBJEDNAVKY==='NEDORAZIL';}).forEach(function(missed){if(records.some(function(r){return r.key==='settled:'+missed.ORDER_ID;}))return;var next=orders.filter(function(o){return String(o.CUSTOMER_ID)===String(missed.CUSTOMER_ID)&&o.ORDER_ID!==missed.ORDER_ID&&['NEDORAZIL','ZRUŠENO','DOKONČENO','VYHOTOVENO'].indexOf(o.STAV_OBJEDNAVKY)<0&&stamp(o)>stamp(missed)&&stamp(o)>=at;}).sort(function(a,b){return stamp(a).localeCompare(stamp(b));})[0];if(!next)return;var key='mail:'+perfect101Hash_(missed.ORDER_ID+'|'+next.ORDER_ID);if(records.some(function(r){return r.key===key;}))return;var n=perfect103NoShowList_(missed.CUSTOMER_ID,[missed],[])[0],text=['UPOZORNĚNÍ: zákazník se dříve nedostavil bez zrušení/omluvy (stav NEDORAZIL).','Zákazník: '+next.JMENO_PRIJMENI,'Telefon: '+next.TELEFON,'E-mail: '+next.EMAIL,'','Předchozí zakázka: '+n.orderId,'Termín: '+n.date+' '+n.time,'Vozidlo: '+n.vehicle+' · SPZ '+n.plate,'Program: '+n.program,'Původní cena: '+(n.priceCents===null?'neurčena':(n.priceCents/100).toFixed(2)+' Kč'),'POKUTA 50 % K DOÚČTOVÁNÍ: '+(n.feeCents===null?'nejprve doplnit původní cenu':(n.feeCents/100).toFixed(2)+' Kč'),'','Nová rezervace: '+next.ORDER_ID,'Termín: '+stamp(next),'Program: '+next.MYCI_PROGRAM,'Vozidlo: '+next.VOZIDLO+' · '+perfect103PlateDisplay_(next.SPZ),'','Přidejte pokutu do ceny nové zakázky a v kartě zákazníka označte jako vyúčtovanou. Tato zpráva cenu automaticky nemění.'].join('\n');var job={key:key,kind:'mail',status:'pending',customerId:String(missed.CUSTOMER_ID),missedOrderId:missed.ORDER_ID,nextOrderId:next.ORDER_ID,to:'rabitensro@gmail.com',subject:'PERFECT: NEDORAZIL — doúčtovat 50 % — '+String(next.ORDER_ID).slice(0,50),text:text,createdAt:now.toISOString(),attempts:0};perfect103NoShowPut_(job);records.push(job);});return records;});}
function perfect103NoShowClaim_(){return perfectDatabaseWithLock_('Pošta nedostavení',function(){var records=perfect103NoShowScan_(),now=Date.now(),job=records.find(function(r){return r.kind==='mail'&&(r.status==='pending'||r.status==='sending'&&Number(r.leaseUntil)<now)&&(!r.nextAttempt||r.nextAttempt<now);});if(!job)return null;var old=databaseFindOrderById(job.missedOrderId),next=databaseFindOrderById(job.nextOrderId);if(!old||old.STAV_OBJEDNAVKY!=='NEDORAZIL'||!next||['ZRUŠENO','NEDORAZIL'].indexOf(next.STAV_OBJEDNAVKY)>=0||records.some(function(r){return r.key==='settled:'+job.missedOrderId;})){job.status='cancelled';perfect103NoShowPut_(job);return null;}if(job.firstAttempt&&now-job.firstAttempt>23*3600000){job.status='review';perfect103NoShowPut_(job);return null;}job.firstAttempt=job.firstAttempt||now;job.attempts++;job.status='sending';job.leaseUntil=now+120000;perfect103NoShowPut_(job);return job;});}
function perfect103NoShowFinish_(key,ok,providerId){return perfectDatabaseWithLock_('Potvrzení pošty',function(){var job=perfect103NoShowRows_().find(function(r){return r.key===key;});if(!job)throw Error('Zpráva nenalezena.');if(job.status==='sent')return;job.status=ok?'sent':'pending';job.providerId=String(providerId||'').slice(0,150);job.updatedAt=new Date().toISOString();job.nextAttempt=Date.now()+300000;perfect103NoShowPut_(job);});}
/** Apps Script používá Resend také, aby se při nejasné odpovědi neposílaly duplicity. */
function perfect103NoShowMailTrigger_(){return perfect40Trusted_(function(){var p=PropertiesService.getScriptProperties(),key=p.getProperty('PERFECT103_RESEND_API_KEY'),from=p.getProperty('PERFECT103_MAIL_FROM');if(!key||!from)throw Error('Nastav PERFECT103_RESEND_API_KEY a PERFECT103_MAIL_FROM.');var job=perfect103NoShowClaim_();if(!job)return;try{var response=UrlFetchApp.fetch('https://api.resend.com/emails',{method:'post',contentType:'application/json',headers:{Authorization:'Bearer '+key,'Idempotency-Key':job.key},payload:JSON.stringify({from:from,to:[job.to],subject:job.subject,text:job.text}),muteHttpExceptions:true}),body=JSON.parse(response.getContentText());perfect103NoShowFinish_(job.key,response.getResponseCode()>=200&&response.getResponseCode()<300&&!!body.id,body.id||'HTTP '+response.getResponseCode());}catch(e){perfect103NoShowFinish_(job.key,false,'Nejasná odpověď');}});}
function perfect103InstallNoShowMail(){if(!perfect40TrustedEditor_())throw Error('Spusť z editoru jako vlastník.');var p=PropertiesService.getScriptProperties();if(!p.getProperty('PERFECT103_RESEND_API_KEY')||!p.getProperty('PERFECT103_MAIL_FROM'))throw Error('Nejdříve nastav e-mailový konektor.');if(!ScriptApp.getProjectTriggers().some(function(t){return t.getHandlerFunction()==='perfect103NoShowMailTrigger_';}))ScriptApp.newTrigger('perfect103NoShowMailTrigger_').timeBased().everyMinutes(1).create();}
